# TMDB API Configuration
# Get your free API key from: https://www.themoviedb.org/
# Sign up -> Settings -> API -> Request an API Key
TMDB_API_KEY=your_tmdb_api_key_here

# MakeMKV Executable Path
# Windows example:
MAKEMKVCON_PATH=C:\Program Files (x86)\MakeMKV\makemkvcon.exe
# macOS/Linux example (if MakeMKV is in PATH):
# MAKEMKVCON_PATH=makemkvcon

# Output Directory
# This is where all your ripped movies will be saved
# Windows example:
RIP_OUTPUT_ROOT=D:\Movies
# macOS example:
# RIP_OUTPUT_ROOT=/Users/YourName/Movies
# Linux example:
# RIP_OUTPUT_ROOT=/home/YourName/Movies
